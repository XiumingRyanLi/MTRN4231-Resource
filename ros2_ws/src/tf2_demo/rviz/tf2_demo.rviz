Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /TF1/Frames1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 10
      Cell Size: 0.2
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Frame Timeout: 15
    - Class: rviz_default_plugins/PointStamped
      Name: Target (camera_link frame)
      Enabled: true
      Topic:
        Value: /target_in_camera_frame
      Color: 255; 0; 0
      Radius: 0.05
    - Class: rviz_default_plugins/PointStamped
      Name: Target (base_link frame)
      Enabled: true
      Topic:
        Value: /target_in_base_link
      Color: 0; 255; 0
      Radius: 0.08
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0.5
        Y: 0
        Z: 0.2
      Name: Current View
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
